# 1 "vendor/mediatek/proprietary/hardware/fstab/mt6768/fstab.in.mt6768" 2
# 155 "vendor/mediatek/proprietary/hardware/fstab/mt6768/fstab.in.mt6768"
# fstab.mt6768 - MediaTek mt6768 fstab for Redmi 13 (moon_gl)
# Supports: FBE v2, inlinecrypt, f2fs, metadata encryption

# Metadata partition (holds encryption keys)
/metadata /metadata ext4 nosuid,nodev,noatime,discard wait,check,formattable,first_stage_mount

# Data partition with FBE v2
/data f2fs noatime,nosuid,nodev,discard,inlinecrypt,quota,fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption wait,check,formattable,encryptable=userdata,subpartitionof=/metadata

# System partitions
/system /system ext4 ro,barrier=1 wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
/vendor /vendor ext4 ro,barrier=1 wait,slotselect,avb,logical,first_stage_mount
/product /product ext4 ro,barrier=1 wait,slotselect,avb,logical,first_stage_mount
/system_ext /system_ext ext4 ro,barrier=1 wait,slotselect,avb,logical,first_stage_mount

# Misc system partitions
/cache /cache ext4 noatime,nosuid,nodev,noauto_da_alloc,discard wait,check,formattable
/misc /misc emmc defaults defaults
/boot /boot emmc defaults first_stage_mount,nofail,slotselect
/vendor_boot /vendor_boot emmc defaults defaults
/dtbo /dtbo emmc defaults defaults
/vbmeta /vbmeta emmc defaults defaults
/vbmeta_system /vbmeta_system emmc defaults,avb=vbmeta

# Optional (can be removed if unused)
/persist /mnt/vendor/persist ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable
/nvdata /mnt/vendor/nvdata ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable
/nvcfg /mnt/vendor/nvcfg ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable
/protect_f /mnt/vendor/protect_f ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable
/protect_s /mnt/vendor/protect_s ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable