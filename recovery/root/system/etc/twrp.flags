# twrp.flags - Redmi 13 (moon_gl) with FBE v2 support

# Metadata partition (must be mounted before /data)
/metadata ext4 /dev/block/by-name/md_udc flags=display="Metadata";backup=1;wipeduringfactoryreset;removable=0

# Data partition with FBE v2
/data f2fs /dev/block/by-name/userdata flags=fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption;display="Data";storage;backup=1;wipeduringfactoryreset;wipeingui;subpartitionof=/metadata

# Cache
/cache ext4 /dev/block/by-name/rescue flags=display="Cache";backup=1;wipeduringfactoryreset;wipeingui

# Misc
/misc emmc /dev/block/by-name/misc flags=display="Miscellaneous"
/para emmc /dev/block/by-name/para flags=display="Para"

# Boot partitions
/boot emmc /dev/block/by-name/boot flags=display="Boot Image";slotselect;backup=1;flashimg=1
/vendor_boot emmc /dev/block/by-name/vendor_boot flags=display="Vendor Boot";slotselect;backup=1;flashimg=1
/dtbo emmc /dev/block/by-name/dtbo flags=display="DTBO";slotselect;backup=1;flashimg=1
/logo auto /dev/block/by-name/logo flags=display="Logo";backup=1;slotselect
/seccfg auto /dev/block/by-name/seccfg flags=display="Secure Configuration"

# VBMeta partitions
/vbmeta emmc /dev/block/by-name/vbmeta flags=display="VBMeta";slotselect;flashimg=1
/vbmeta_vendor emmc /dev/block/by-name/vbmeta_vendor flags=display="VBMeta Vendor";slotselect;backup=1;flashimg=1
/vbmeta_system emmc /dev/block/by-name/vbmeta_system flags=display="VBMeta System";slotselect;backup=1;flashimg=1

# Secure storage
/nvram_image emmc /dev/block/by-name/nvram flags=display="IMEI/NVRAM";backup=1;subpartitionof=/nvram_image
/nvdata ext4 /dev/block/by-name/nvdata flags=backup;subpartitionof=/nvram_image
/nvcfg ext4 /dev/block/by-name/nvcfg flags=backup;subpartitionof=/nvram_image
/persist_image emmc /dev/block/by-name/persist flags=backup;subpartitionof=/nvram_image
/protect1_image emmc /dev/block/by-name/protect1 flags=backup;subpartitionof=/nvram_image
/protect2_image emmc /dev/block/by-name/protect2 flags=backup;subpartitionof=/nvram_image
/proinfo_image emmc /dev/block/by-name/proinfo flags=backup;subpartitionof=/nvram_image
/seccfg_image emmc /dev/block/by-name/seccfg flags=backup;subpartitionof=/nvram_image

# OEM Partitions
/tee1 emmc /dev/block/by-name/tee1 flags=display="TEE1"
/tee2 emmc /dev/block/by-name/tee2 flags=display="TEE2"
/scp1 emmc /dev/block/by-name/scp1 flags=display="SCP1"
/scp2 emmc /dev/block/by-name/scp2 flags=display="SCP2"
/sspm1 emmc /dev/block/by-name/sspm1 flags=display="SSPM1"
/sspm2 emmc /dev/block/by-name/sspm2 flags=display="SSPM2"
/dpm1 emmc /dev/block/by-name/dpm1 flags=display="DPM1"
/dpm2 emmc /dev/block/by-name/dpm2 flags=display="DPM2"
/mcupm1 emmc /dev/block/by-name/mcupm1 flags=display="MCU_PM1"
/mcupm2 emmc /dev/block/by-name/mcupm2 flags=display="MCU_PM2"
/md1img emmc /dev/block/by-name/md1img flags=display="MD1IMG"
/md1dsp emmc /dev/block/by-name/md1dsp flags=display="MD1DSP"
/md1arm7 emmc /dev/block/by-name/md1arm7 flags=display="MD1ARM7"
/md3img emmc /dev/block/by-name/md3img flags=display="MD3IMG"
/gz1 emmc /dev/block/by-name/gz1 flags=display="GZ1"
/gz2 emmc /dev/block/by-name/gz2 flags=display="GZ2"
/ccu emmc /dev/block/by-name/ccu flags=display="CCU"
/vcp emmc /dev/block/by-name/vcp flags=display="VCP"
/gpueb emmc /dev/block/by-name/gpueb flags=display="GPU_EB"
/mcf_ota emmc /dev/block/by-name/mcf_ota flags=display="MCF OTA"

# Images
/system_image emmc /dev/block/mapper/system flags=display="System Image";slotselect;backup=1;flashimg=1
/system_ext_image emmc /dev/block/mapper/system_ext flags=display="System_EXT Image";slotselect;backup=1;flashimg=1
/vendor_image emmc /dev/block/mapper/vendor flags=display="Vendor Image";slotselect;backup=1;flashimg=1
/product_image emmc /dev/block/mapper/product flags=display="Product Image";slotselect;backup=1;flashimg=1

# Removable Storage
/external_sd auto /dev/block/mmcblk0p1 /dev/block/mmcblk1p1 flags=display="SD Card";storage;removable;wipeingui
/usb_otg auto /dev/block/sda1 /dev/block/sdd1 flags=display="USB OTG";storage;removable;wipeingui

# Misc
/cust ext4 /dev/block/by-name/cust flags=display="Cust";wipeingui